<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= category ? category.name : 'Category' %> - Shool Bazar</title>
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet" />
  <style>
    /* Same full CSS as index.ejs – for brevity, include the same styles from index.ejs */
    /* (Copy the entire <style> block from index.ejs here) */
    :root { /* ... */ }
    /* ... all styles ... */
    /* For production, move to public/styles.css and include via <link> */
  </style>
  <!-- Include the same CSS – for brevity we reference it; but to be safe, embed it -->
  <style>
    /* Paste the full CSS from index.ejs here */
    /* Alternatively, include a link to /styles.css if you create it */
  </style>
</head>
<body>
  <!-- HEADER (same as index.ejs) -->
  <header class="site-header" id="siteHeader">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="header-brand">
          <img src="/images/logo.jpeg" alt="Shool Bazar" />
          <span>Shool <span class="gold">Bazar</span></span>
        </a>
        <div class="header-search" id="desktopSearch">
          <input type="text" id="searchInputDesktop" placeholder="Search products..." autocomplete="off" />
          <span class="search-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
          <div class="search-results-overlay" id="searchResultsDesktop"></div>
        </div>
        <div class="header-actions">
          <a href="/" class="btn btn-outline-gold btn-sm"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-9 9 9"/><path d="M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10"/></svg><span>Home</span></a>
          <button class="hamburger" id="hamburgerBtn"><span></span><span></span><span></span></button>
        </div>
      </div>
      <div class="header-search mobile-show" id="mobileSearch" style="display:none; margin-top:8px;">
        <input type="text" id="searchInputMobile" placeholder="Search..." autocomplete="off" />
        <span class="search-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
        <div class="search-results-overlay" id="searchResultsMobile"></div>
      </div>
      <div class="mobile-nav" id="mobileNav">
        <a href="/">Home</a><a href="/categories">Categories</a><a href="/about">About</a><a href="/contact">Contact</a><a href="/privacy">Privacy Policy</a><a href="/terms">Terms</a>
      </div>
    </div>
  </header>

  <!-- CATEGORY NAV -->
  <nav class="category-nav" id="categoryNav">
    <div class="container" id="categoryList">
      <% if (categories && categories.length) { %>
        <a href="/" class="<%= !currentCategory ? 'active' : '' %>">?? All</a>
        <% categories.forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="<%= currentCategory && currentCategory.id === cat.id ? 'active' : '' %>" data-cat-id="<%= cat.id %>">
            <%= cat.icon || '??' %> <%= cat.name %>
          </a>
        <% }); %>
      <% } else { %>
        <span style="color:var(--gray-500);font-size:0.85rem;padding:4px 8px;">No categories</span>
      <% } %>
    </div>
  </nav>

  <!-- CATEGORY HEADER -->
  <div class="category-header" style="background:var(--white);padding:24px 0;border-bottom:1px solid var(--gray-200);margin-bottom:24px;">
    <div class="container">
      <h1><%= category ? category.name : 'Category' %></h1>
      <% if (category && category.description) { %><p><%= category.description %></p><% } %>
    </div>
  </div>

  <!-- PRODUCT GRID -->
  <section class="products-section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">Products in <span class="gold"><%= category ? category.name : 'Category' %></span></h2>
          <p class="section-subtitle"><%= totalProducts %> products</p>
        </div>
        <!-- Sorting -->
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
          <label style="font-weight:500;font-size:0.85rem;color:var(--gray-600);">Sort by:</label>
          <select id="sortSelect" style="padding:6px 12px;border-radius:var(--radius-sm);border:1px solid var(--gray-300);background:var(--white);font-size:0.85rem;outline:none;">
            <option value="newest">Newest</option>
            <option value="price_low">Price: Low to High</option>
            <option value="price_high">Price: High to Low</option>
            <option value="discount">Discount</option>
            <option value="popular">Popular</option>
          </select>
        </div>
      </div>
      <div class="products-grid" id="allProductsGrid">
        <% if (products && products.length) { %>
          <% products.forEach(p => { %>
            <div class="product-card" data-product-id="<%= p.id %>" data-slug="<%= p.slug %>">
              <a href="/product/<%= p.slug %>" class="card-image" style="display:block;">
                <img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/images/placeholder.png'" />
                <% if (p.discount && p.discount > 0) { %><span class="discount-badge"><%= Math.round(p.discount) %>% OFF</span><% } %>
              </a>
              <div class="card-body">
                <a href="/product/<%= p.slug %>" class="product-name"><%= p.name %></a>
                <% if (p.brand) { %><div class="product-brand"><%= p.brand %></div><% } %>
                <div class="product-price">
                  <% if (p.price) { %>
                    <span class="current-price">?<%= Number(p.price).toLocaleString('en-IN') %></span>
                    <% if (p.mrp && p.mrp != p.price) { %><span class="original-price">?<%= Number(p.mrp).toLocaleString('en-IN') %></span><% } %>
                    <% if (p.discount && p.discount > 0) { %><span class="discount-text"><%= Math.round(p.discount) %>%</span><% } %>
                  <% } else { %><span style="color:var(--gray-500);font-size:0.85rem;">Price on request</span><% } %>
                </div>
              </div>
              <div class="card-footer">
                <a href="/product/<%= p.slug %>" class="btn btn-outline-navy btn-sm">View</a>
                <a href="/go/<%= p.slug %>" class="btn btn-gold btn-sm" data-track-click="<%= p.id %>">Buy Now</a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state" style="grid-column:1/-1;">
            <div class="empty-icon">??</div>
            <h3>No products in this category</h3>
            <p>Check back later.</p>
          </div>
        <% } %>
      </div>
      <!-- Pagination -->
      <div class="pagination" id="paginationControls">
        <% if (totalPages > 1) { %>
          <% const current = currentPage || 1; %>
          <a href="/category/<%= category.slug %>?page=<%= current-1 %>" class="<%= current <= 1 ? 'disabled' : '' %>">‹</a>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= current-2 && i <= current+2)) { %>
              <a href="/category/<%= category.slug %>?page=<%= i %>" class="<%= i === current ? 'active' : '' %>"><%= i %></a>
            <% } else if (i === current-3 || i === current+3) { %><span>…</span><% } %>
          <% } %>
          <a href="/category/<%= category.slug %>?page=<%= current+1 %>" class="<%= current >= totalPages ? 'disabled' : '' %>">›</a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- FOOTER (same as index) -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-brand"><img src="/images/logo.jpeg" alt="Shool Bazar" /><span>Shool <span class="gold">Bazar</span></span></div>
          <p style="font-size:0.9rem;color:rgba(255,255,255,0.5);max-width:260px;">Discover amazing products from trusted merchants.</p>
        </div>
        <div><h4>Quick Links</h4><a href="/">Home</a><a href="/categories">Categories</a><a href="/about">About</a><a href="/contact">Contact</a></div>
        <div><h4>Policies</h4><a href="/privacy">Privacy Policy</a><a href="/terms">Terms &amp; Conditions</a><a href="/disclaimer">Disclaimer</a></div>
        <div><h4>Connect</h4><a href="#">Facebook</a><a href="#">Instagram</a><a href="#">Twitter</a></div>
      </div>
      <div class="footer-bottom"><span>&copy; 2026 Shool Bazar. All rights reserved.</span><span>Made with ??</span></div>
    </div>
  </footer>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <!-- META PIXEL & SCRIPTS (same as index) -->
  <script>
    // Same Meta Pixel and client script as index.ejs
    // Paste the same script block from index.ejs here
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1365924354934790&ev=PageView&noscript=1"/></noscript>
  <script>
    // Copy the entire client script from index.ejs (including search, hamburger, tracking)
    // For brevity, we include a reference to a shared script, but here we repeat.
  </script>
</body>
</html>
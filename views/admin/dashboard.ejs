<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - Shool Bazar Admin</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    /* Admin specific styles – can be in /styles.css */
    .admin-layout { display:flex; min-height:100vh; background:var(--gray-50); }
    .admin-sidebar { width:260px; background:var(--navy); color:var(--white); padding:24px 0; flex-shrink:0; position:sticky; top:0; height:100vh; overflow-y:auto; }
    .admin-sidebar .sidebar-brand { display:flex; align-items:center; gap:10px; padding:0 24px 24px; border-bottom:1px solid rgba(255,255,255,0.08); margin-bottom:16px; }
    .admin-sidebar .sidebar-brand img { height:36px; width:auto; }
    .admin-sidebar .sidebar-brand span { font-size:1.1rem; font-weight:700; }
    .admin-sidebar .sidebar-brand span .gold { color:var(--gold); }
    .admin-sidebar .nav-item { display:flex; align-items:center; gap:12px; padding:12px 24px; color:rgba(255,255,255,0.6); transition:var(--transition); font-weight:500; font-size:0.9rem; border-left:3px solid transparent; }
    .admin-sidebar .nav-item:hover { color:var(--white); background:rgba(255,255,255,0.05); }
    .admin-sidebar .nav-item.active { color:var(--white); background:rgba(212,167,69,0.12); border-left-color:var(--gold); }
    .admin-sidebar .nav-item .icon { font-size:1.2rem; width:24px; text-align:center; }
    .admin-sidebar .sidebar-footer { margin-top:auto; padding:16px 24px; border-top:1px solid rgba(255,255,255,0.08); }
    .admin-sidebar .sidebar-footer .nav-item { padding:8px 0; font-size:0.85rem; }
    .admin-sidebar .sidebar-footer .nav-item:hover { background:none; }
    .admin-main { flex:1; padding:24px 32px; max-width:calc(100% - 260px); }
    .admin-main .page-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:24px; }
    .admin-main .page-header h1 { font-size:1.6rem; font-weight:700; color:var(--navy); }
    .admin-stats { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px,1fr)); gap:16px; margin-bottom:28px; }
    .admin-stat-card { background:var(--white); padding:20px 24px; border-radius:var(--radius); border:1px solid var(--gray-200); box-shadow:var(--shadow-sm); }
    .admin-stat-card .stat-number { font-size:2rem; font-weight:700; color:var(--navy); line-height:1.2; }
    .admin-stat-card .stat-label { font-size:0.85rem; color:var(--gray-600); }
    .admin-stat-card .stat-icon { float:right; font-size:2rem; opacity:0.2; }
    .admin-table-wrap { background:var(--white); border-radius:var(--radius); border:1px solid var(--gray-200); overflow:auto; box-shadow:var(--shadow-sm); }
    .admin-table { width:100%; border-collapse:collapse; font-size:0.9rem; min-width:600px; }
    .admin-table th { background:var(--gray-50); text-align:left; padding:12px 16px; font-weight:600; color:var(--gray-700); border-bottom:1px solid var(--gray-200); white-space:nowrap; }
    .admin-table td { padding:12px 16px; border-bottom:1px solid var(--gray-100); vertical-align:middle; }
    .admin-table tr:hover td { background:var(--gray-50); }
    @media (max-width:1024px) { .admin-sidebar { width:260px; padding:16px 0; } .admin-sidebar .sidebar-brand span, .admin-sidebar .nav-item span:not(.icon), .admin-sidebar .sidebar-footer .nav-item span:not(.icon) { display:none; } .admin-sidebar .sidebar-brand { padding:0 16px 16px; justify-content:center; } .admin-sidebar .nav-item { padding:14px 16px; justify-content:center; } .admin-sidebar .sidebar-footer .nav-item { padding:14px 16px; justify-content:center; } .admin-main { max-width:calc(100% - 72px); padding:16px; } }
    @media (max-width:768px) { .admin-layout { flex-direction:column; } .admin-sidebar { width:100%; height:auto; position:static; flex-direction:row; padding:8px 16px; flex-wrap:wrap; align-items:center; gap:4px; } .admin-sidebar .sidebar-brand { padding:0; margin:0; border:none; flex:1; } .admin-sidebar .sidebar-brand img { height:28px; } .admin-sidebar .sidebar-brand span { display:inline !important; font-size:0.95rem; } .admin-sidebar .nav-item { padding:8px 12px; font-size:0.8rem; border-left:none; border-bottom:2px solid transparent; } .admin-sidebar .nav-item.active { border-left:none; border-bottom-color:var(--gold); } .admin-sidebar .nav-item .icon { font-size:1rem; width:20px; } .admin-sidebar .nav-item span:not(.icon) { display:inline !important; } .admin-sidebar .sidebar-footer { display:none; } .admin-main { max-width:100%; padding:12px; } .admin-main .page-header h1 { font-size:1.3rem; } .admin-stats { grid-template-columns:repeat(2,1fr); gap:10px; } .admin-stat-card .stat-number { font-size:1.4rem; } }
  </style>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <div class="sidebar-brand">
        <img src="/images/shool%20bazar%20logo.jpeg" alt="Shool Bazar" />
        <span>Shool <span class="gold">Bazar</span></span>
      </div>
      <a href="/admin/dashboard" class="nav-item active"><span class="icon">??</span><span>Dashboard</span></a>
      <a href="/admin/products" class="nav-item"><span class="icon">??</span><span>Products</span></a>
      <a href="/admin/categories" class="nav-item"><span class="icon">???</span><span>Categories</span></a>
      <div class="sidebar-footer">
        <a href="/admin/logout" class="nav-item"><span class="icon">??</span><span>Logout</span></a>
      </div>
    </aside>
    <!-- Main -->
    <main class="admin-main">
      <div class="page-header">
        <h1>Dashboard</h1>
        <span class="sub">Welcome back, Admin</span>
      </div>
      <!-- Stats -->
      <div class="admin-stats">
        <div class="admin-stat-card">
          <span class="stat-icon">??</span>
          <div class="stat-number"><%= totalProducts || 0 %></div>
          <div class="stat-label">Total Products</div>
        </div>
        <div class="admin-stat-card">
          <span class="stat-icon">?</span>
          <div class="stat-number"><%= activeProducts || 0 %></div>
          <div class="stat-label">Active Products</div>
        </div>
        <div class="admin-stat-card">
          <span class="stat-icon">?</span>
          <div class="stat-number"><%= inactiveProducts || 0 %></div>
          <div class="stat-label">Inactive Products</div>
        </div>
        <div class="admin-stat-card">
          <span class="stat-icon">???</span>
          <div class="stat-number"><%= totalCategories || 0 %></div>
          <div class="stat-label">Categories</div>
        </div>
        <div class="admin-stat-card">
          <span class="stat-icon">??</span>
          <div class="stat-number"><%= uncategorized || 0 %></div>
          <div class="stat-label">Uncategorized</div>
        </div>
        <div class="admin-stat-card">
          <span class="stat-icon">??</span>
          <div class="stat-number"><%= totalClicks || 0 %></div>
          <div class="stat-label">Total Clicks</div>
        </div>
      </div>
      <!-- Recent Products -->
      <div style="margin-bottom:24px;">
        <h3 style="font-size:1.1rem;font-weight:600;color:var(--navy);margin-bottom:12px;">Recently Added</h3>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>Image</th><th>Name</th><th>Price</th><th>Status</th><th>Added</th></tr></thead>
            <tbody>
              <% if (recent && recent.length) { %>
                <% recent.forEach(p => { %>
                  <tr>
                    <td><img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" class="product-thumb" style="width:48px;height:48px;object-fit:cover;border-radius:var(--radius-sm);background:var(--gray-100);" onerror="this.src='/images/placeholder.png'" /></td>
                    <td><%= p.name %></td>
                    <td><%= p.price ? '?'+Number(p.price).toLocaleString('en-IN') : '-' %></td>
                    <td><span class="badge <%= p.status === 'active' ? 'badge-active' : 'badge-inactive' %>"><%= p.status %></span></td>
                    <td><%= new Date(p.created_at).toLocaleDateString() %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="5" style="text-align:center;padding:20px;color:var(--gray-500);">No recent products</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <!-- Popular Products -->
      <div>
        <h3 style="font-size:1.1rem;font-weight:600;color:var(--navy);margin-bottom:12px;">Most Clicked</h3>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>Image</th><th>Name</th><th>Clicks</th><th>Price</th></tr></thead>
            <tbody>
              <% if (popular && popular.length) { %>
                <% popular.forEach(p => { %>
                  <tr>
                    <td><img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" class="product-thumb" style="width:48px;height:48px;object-fit:cover;border-radius:var(--radius-sm);background:var(--gray-100);" onerror="this.src='/images/placeholder.png'" /></td>
                    <td><%= p.name %></td>
                    <td><%= p.click_count || 0 %></td>
                    <td><%= p.price ? '?'+Number(p.price).toLocaleString('en-IN') : '-' %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="4" style="text-align:center;padding:20px;color:var(--gray-500);">No clicks data yet</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products - Shool Bazar Admin</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    /* Same admin styles as dashboard – include here or in /styles.css */
    .admin-layout { display:flex; min-height:100vh; background:var(--gray-50); }
    .admin-sidebar { width:260px; background:var(--navy); color:var(--white); padding:24px 0; flex-shrink:0; position:sticky; top:0; height:100vh; overflow-y:auto; }
    .admin-sidebar .sidebar-brand { display:flex; align-items:center; gap:10px; padding:0 24px 24px; border-bottom:1px solid rgba(255,255,255,0.08); margin-bottom:16px; }
    .admin-sidebar .sidebar-brand img { height:36px; width:auto; }
    .admin-sidebar .sidebar-brand span { font-size:1.1rem; font-weight:700; }
    .admin-sidebar .sidebar-brand span .gold { color:var(--gold); }
    .admin-sidebar .nav-item { display:flex; align-items:center; gap:12px; padding:12px 24px; color:rgba(255,255,255,0.6); transition:var(--transition); font-weight:500; font-size:0.9rem; border-left:3px solid transparent; }
    .admin-sidebar .nav-item:hover { color:var(--white); background:rgba(255,255,255,0.05); }
    .admin-sidebar .nav-item.active { color:var(--white); background:rgba(212,167,69,0.12); border-left-color:var(--gold); }
    .admin-sidebar .nav-item .icon { font-size:1.2rem; width:24px; text-align:center; }
    .admin-sidebar .sidebar-footer { margin-top:auto; padding:16px 24px; border-top:1px solid rgba(255,255,255,0.08); }
    .admin-sidebar .sidebar-footer .nav-item { padding:8px 0; font-size:0.85rem; }
    .admin-sidebar .sidebar-footer .nav-item:hover { background:none; }
    .admin-main { flex:1; padding:24px 32px; max-width:calc(100% - 260px); }
    .admin-main .page-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:24px; }
    .admin-main .page-header h1 { font-size:1.6rem; font-weight:700; color:var(--navy); }
    .admin-table-wrap { background:var(--white); border-radius:var(--radius); border:1px solid var(--gray-200); overflow:auto; box-shadow:var(--shadow-sm); }
    .admin-table { width:100%; border-collapse:collapse; font-size:0.9rem; min-width:800px; }
    .admin-table th { background:var(--gray-50); text-align:left; padding:12px 16px; font-weight:600; color:var(--gray-700); border-bottom:1px solid var(--gray-200); white-space:nowrap; }
    .admin-table td { padding:12px 16px; border-bottom:1px solid var(--gray-100); vertical-align:middle; }
    .admin-table tr:hover td { background:var(--gray-50); }
    .admin-table .product-thumb { width:48px; height:48px; object-fit:cover; border-radius:var(--radius-sm); background:var(--gray-100); }
    .badge { display:inline-block; padding:2px 12px; border-radius:var(--radius-full); font-size:0.7rem; font-weight:600; }
    .badge-active { background:#d4edda; color:#155724; }
    .badge-inactive { background:#f8d7da; color:#721c24; }
    .badge-draft { background:#fff3cd; color:#856404; }
    .badge-featured { background:var(--gold); color:var(--navy); }
    .admin-table .actions { display:flex; gap:6px; flex-wrap:wrap; }
    .admin-table .actions .btn { padding:4px 10px; font-size:0.7rem; min-height:30px; min-width:30px; }
    .btn-sm { padding:6px 12px; font-size:0.8rem; min-height:34px; }
    @media (max-width:1024px) { .admin-sidebar { width:72px; padding:16px 0; } .admin-sidebar .sidebar-brand span, .admin-sidebar .nav-item span:not(.icon), .admin-sidebar .sidebar-footer .nav-item span:not(.icon) { display:none; } .admin-sidebar .sidebar-brand { padding:0 16px 16px; justify-content:center; } .admin-sidebar .nav-item { padding:14px 16px; justify-content:center; } .admin-sidebar .sidebar-footer .nav-item { padding:14px 16px; justify-content:center; } .admin-main { max-width:calc(100% - 72px); padding:16px; } }
    @media (max-width:768px) { .admin-layout { flex-direction:column; } .admin-sidebar { width:100%; height:auto; position:static; flex-direction:row; padding:8px 16px; flex-wrap:wrap; align-items:center; gap:4px; } .admin-sidebar .sidebar-brand { padding:0; margin:0; border:none; flex:1; } .admin-sidebar .sidebar-brand img { height:28px; } .admin-sidebar .sidebar-brand span { display:inline !important; font-size:0.95rem; } .admin-sidebar .nav-item { padding:8px 12px; font-size:0.8rem; border-left:none; border-bottom:2px solid transparent; } .admin-sidebar .nav-item.active { border-left:none; border-bottom-color:var(--gold); } .admin-sidebar .nav-item .icon { font-size:1rem; width:20px; } .admin-sidebar .nav-item span:not(.icon) { display:inline !important; } .admin-sidebar .sidebar-footer { display:none; } .admin-main { max-width:100%; padding:12px; } .admin-main .page-header h1 { font-size:1.3rem; } .admin-table-wrap { font-size:0.8rem; } .admin-table th, .admin-table td { padding:8px 10px; } .admin-table .product-thumb { width:32px; height:32px; } }
  </style>
</head>
<body>
  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="sidebar-brand">
        <img src="/images/logo.jpeg" alt="Shool Bazar" />
        <span>Shool <span class="gold">Bazar</span></span>
      </div>
      <a href="/admin/dashboard" class="nav-item"><span class="icon">??</span><span>Dashboard</span></a>
      <a href="/admin/products" class="nav-item active"><span class="icon">??</span><span>Products</span></a>
      <a href="/admin/categories" class="nav-item"><span class="icon">???</span><span>Categories</span></a>
      <div class="sidebar-footer">
        <a href="/admin/logout" class="nav-item"><span class="icon">??</span><span>Logout</span></a>
      </div>
    </aside>
    <main class="admin-main">
      <div class="page-header">
        <h1>Products</h1>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <a href="/admin/products/add" class="btn btn-gold btn-sm">+ Add Product</a>
          <a href="/admin/products/bulk" class="btn btn-outline-navy btn-sm">Bulk Add</a>
        </div>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Merchant</th>
              <th>Status</th>
              <th>Featured</th>
              <th>Clicks</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length) { %>
              <% products.forEach(p => { %>
                <tr>
                  <td><img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" class="product-thumb" onerror="this.src='/images/placeholder.png'" /></td>
                  <td><%= p.name %></td>
                  <td><%= p.category_name || 'Uncategorized' %></td>
                  <td><%= p.price ? '?'+Number(p.price).toLocaleString('en-IN') : '-' %></td>
                  <td><%= p.merchant || '-' %></td>
                  <td><span class="badge <%= p.status === 'active' ? 'badge-active' : (p.status === 'draft' ? 'badge-draft' : 'badge-inactive') %>"><%= p.status %></span></td>
                  <td><%= p.featured ? '?' : '' %></td>
                  <td><%= p.click_count || 0 %></td>
                  <td class="actions">
                    <a href="/admin/products/edit/<%= p.id %>" class="btn btn-outline-navy btn-sm">Edit</a>
                    <form method="POST" action="/admin/products/toggle/<%= p.id %>" style="display:inline;">
                      <button type="submit" class="btn btn-sm <%= p.status === 'active' ? 'btn-outline-navy' : 'btn-gold' %>"><%= p.status === 'active' ? 'Deactivate' : 'Activate' %></button>
                    </form>
                    <form method="POST" action="/admin/products/delete/<%= p.id %>" style="display:inline;" onsubmit="return confirm('Delete this product?')">
                      <button type="submit" class="btn btn-sm" style="background:#dc3545;color:white;border-color:#dc3545;">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="9" style="text-align:center;padding:20px;color:var(--gray-500);">No products found. <a href="/admin/products/add">Add one</a></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shool Bazar - Discover Amazing Products</title>
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet" />
  <style>
    /* All CSS from the original public page – copy here for brevity */
    /* For production, move to public/styles.css */
    :root {
      --navy: #0a1628;
      --navy-light: #142442;
      --navy-mid: #1a3050;
      --gold: #d4a745;
      --gold-light: #e8c96e;
      --gold-dark: #b8922f;
      --white: #ffffff;
      --gray-50: #f8f9fa;
      --gray-100: #f1f3f5;
      --gray-200: #e9ecef;
      --gray-300: #dee2e6;
      --gray-400: #ced4da;
      --gray-500: #adb5bd;
      --gray-600: #6c757d;
      --gray-700: #495057;
      --gray-800: #343a40;
      --gray-900: #212529;
      --shadow-sm: 0 1px 3px rgba(10, 22, 40, 0.08);
      --shadow-md: 0 4px 16px rgba(10, 22, 40, 0.12);
      --shadow-lg: 0 8px 32px rgba(10, 22, 40, 0.16);
      --shadow-xl: 0 12px 48px rgba(10, 22, 40, 0.2);
      --radius: 12px;
      --radius-sm: 8px;
      --radius-full: 9999px;
      --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    * { box-sizing: border-box; margin:0; padding:0; }
    html { scroll-behavior: smooth; -webkit-tap-highlight-color: transparent; }
    body { font-family: var(--font); background: var(--gray-50); color: var(--gray-900); line-height: 1.6; min-height: 100vh; display: flex; flex-direction: column; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }
    button { cursor: pointer; font-family: inherit; border: none; background: none; }
    input, select, textarea { font-family: inherit; font-size: inherit; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 20px; width: 100%; }
    .text-gold { color: var(--gold); }
    .bg-navy { background: var(--navy); }
    .bg-gold { background: var(--gold); }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 24px; border-radius: var(--radius-full); font-weight: 600; font-size: 0.9rem; transition: var(--transition); border: 2px solid transparent; line-height: 1.4; min-height: 44px; min-width: 44px; }
    .btn-gold { background: var(--gold); color: var(--navy); border-color: var(--gold); }
    .btn-gold:hover { background: var(--gold-dark); border-color: var(--gold-dark); transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .btn-outline-gold { background: transparent; color: var(--gold); border-color: var(--gold); }
    .btn-outline-gold:hover { background: var(--gold); color: var(--navy); }
    .btn-navy { background: var(--navy); color: var(--white); border-color: var(--navy); }
    .btn-navy:hover { background: var(--navy-light); border-color: var(--navy-light); }
    .btn-outline-navy { background: transparent; color: var(--navy); border-color: var(--navy); }
    .btn-outline-navy:hover { background: var(--navy); color: var(--white); }
    .btn-sm { padding: 6px 16px; font-size: 0.8rem; min-height: 34px; }
    .btn-lg { padding: 14px 36px; font-size: 1.05rem; }
    .site-header { background: var(--navy); color: var(--white); position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 16px rgba(10,22,40,0.3); }
    .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 0; flex-wrap: wrap; }
    .header-brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
    .header-brand img { height: 40px; width: auto; object-fit: contain; }
    .header-brand span { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.5px; color: var(--white); }
    .header-brand span .gold { color: var(--gold); }
    .header-search { flex: 1; min-width: 200px; max-width: 560px; position: relative; }
    .header-search input { width: 100%; padding: 10px 44px 10px 18px; border-radius: var(--radius-full); border: none; background: rgba(255,255,255,0.12); color: var(--white); font-size: 0.95rem; transition: var(--transition); outline: 2px solid transparent; height: 44px; }
    .header-search input::placeholder { color: rgba(255,255,255,0.5); }
    .header-search input:focus { background: rgba(255,255,255,0.2); outline-color: var(--gold); }
    .header-search .search-icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,0.4); pointer-events: none; }
    .header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .header-actions .btn-outline-gold { padding: 8px 18px; font-size: 0.8rem; border-color: rgba(212,167,69,0.4); color: var(--gold); }
    .header-actions .btn-outline-gold:hover { background: var(--gold); color: var(--navy); border-color: var(--gold); }
    .hamburger { display: none; flex-direction: column; gap: 4px; padding: 8px; background: none; border: none; cursor: pointer; }
    .hamburger span { display: block; width: 26px; height: 2.5px; background: var(--white); border-radius: 2px; transition: var(--transition); }
    .mobile-nav { display: none; background: var(--navy-light); padding: 12px 20px 20px; border-top: 1px solid rgba(255,255,255,0.06); }
    .mobile-nav.open { display: block; }
    .mobile-nav a { display: block; padding: 10px 0; color: rgba(255,255,255,0.8); font-weight: 500; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .mobile-nav a:hover { color: var(--gold); }
    .mobile-nav a:last-child { border-bottom: none; }
    .category-nav { background: var(--white); border-bottom: 1px solid var(--gray-200); padding: 8px 0; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .category-nav::-webkit-scrollbar { display: none; }
    .category-nav .container { display: flex; gap: 4px; align-items: center; flex-wrap: nowrap; }
    .category-nav a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 16px; border-radius: var(--radius-full); font-size: 0.82rem; font-weight: 500; color: var(--gray-700); white-space: nowrap; transition: var(--transition); background: transparent; }
    .category-nav a:hover { background: var(--gray-100); color: var(--navy); }
    .category-nav a.active { background: var(--navy); color: var(--white); }
    .category-nav a .cat-icon { font-size: 1.1rem; }
    .hero-section { background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%); padding: 48px 0 40px; color: var(--white); text-align: center; }
    .hero-section h1 { font-size: 2.2rem; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 8px; }
    .hero-section h1 .gold { color: var(--gold); }
    .hero-section p { font-size: 1.1rem; color: rgba(255,255,255,0.7); max-width: 560px; margin: 0 auto 24px; }
    .hero-search { max-width: 640px; margin: 0 auto; position: relative; }
    .hero-search input { width: 100%; padding: 16px 56px 16px 24px; border-radius: var(--radius-full); border: none; font-size: 1.05rem; background: var(--white); color: var(--gray-900); box-shadow: var(--shadow-lg); outline: 2px solid transparent; height: 56px; }
    .hero-search input:focus { outline-color: var(--gold); }
    .hero-search button { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); background: var(--gold); color: var(--navy); border: none; border-radius: var(--radius-full); padding: 10px 22px; font-weight: 600; font-size: 0.9rem; transition: var(--transition); }
    .hero-search button:hover { background: var(--gold-dark); }
    .section-title { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.3px; margin-bottom: 4px; color: var(--navy); }
    .section-title .gold { color: var(--gold); }
    .section-subtitle { color: var(--gray-600); margin-bottom: 24px; font-size: 0.95rem; }
    .section-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
    .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; }
    .product-card { background: var(--white); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); transition: var(--transition); display: flex; flex-direction: column; border: 1px solid var(--gray-200); position: relative; }
    .product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--gold); }
    .product-card .card-image { aspect-ratio: 1/1; background: var(--gray-100); overflow: hidden; position: relative; }
    .product-card .card-image img { width: 100%; height: 100%; object-fit: cover; transition: var(--transition); }
    .product-card:hover .card-image img { transform: scale(1.03); }
    .product-card .discount-badge { position: absolute; top: 10px; left: 10px; background: #dc3545; color: var(--white); font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: var(--radius-full); letter-spacing: 0.3px; }
    .product-card .card-body { padding: 14px 16px 16px; flex: 1; display: flex; flex-direction: column; }
    .product-card .card-body .product-name { font-size: 0.95rem; font-weight: 600; color: var(--gray-900); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 4px; }
    .product-card .card-body .product-brand { font-size: 0.75rem; color: var(--gray-500); margin-bottom: 6px; }
    .product-card .card-body .product-price { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--gray-100); }
    .product-card .card-body .current-price { font-size: 1.2rem; font-weight: 700; color: var(--navy); }
    .product-card .card-body .current-price .currency { font-size: 0.8rem; font-weight: 600; }
    .product-card .card-body .original-price { font-size: 0.85rem; color: var(--gray-500); text-decoration: line-through; }
    .product-card .card-body .discount-text { font-size: 0.75rem; font-weight: 600; color: #dc3545; background: #fde8ea; padding: 1px 10px; border-radius: var(--radius-full); }
    .product-card .card-footer { padding: 10px 16px 14px; display: flex; gap: 8px; border-top: 1px solid var(--gray-100); }
    .product-card .card-footer .btn { flex: 1; padding: 8px 10px; font-size: 0.78rem; min-height: 36px; }
    .product-card .card-footer .btn-gold { background: var(--gold); color: var(--navy); border-color: var(--gold); }
    .product-card .card-footer .btn-gold:hover { background: var(--gold-dark); border-color: var(--gold-dark); }
    .product-card .card-footer .btn-outline-navy { border-color: var(--gray-300); color: var(--gray-700); }
    .product-card .card-footer .btn-outline-navy:hover { border-color: var(--navy); color: var(--navy); background: var(--gray-50); }
    .featured-section { background: var(--white); padding: 48px 0; }
    .products-section { padding: 48px 0; }
    .empty-state { text-align: center; padding: 60px 20px; color: var(--gray-600); }
    .empty-state .empty-icon { font-size: 4rem; margin-bottom: 16px; opacity: 0.5; }
    .empty-state h3 { font-size: 1.3rem; color: var(--gray-800); margin-bottom: 4px; }
    .empty-state p { max-width: 400px; margin: 0 auto; }
    .site-footer { background: var(--navy); color: rgba(255,255,255,0.8); padding: 40px 0 20px; margin-top: auto; }
    .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 32px; margin-bottom: 32px; }
    .footer-grid h4 { color: var(--white); font-size: 1rem; margin-bottom: 12px; font-weight: 600; }
    .footer-grid a { display: block; padding: 4px 0; font-size: 0.9rem; color: rgba(255,255,255,0.6); transition: var(--transition); }
    .footer-grid a:hover { color: var(--gold); }
    .footer-brand { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
    .footer-brand img { height: 32px; width: auto; }
    .footer-brand span { font-size: 1.2rem; font-weight: 700; color: var(--white); }
    .footer-brand span .gold { color: var(--gold); }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding-top: 16px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 0.8rem; color: rgba(255,255,255,0.4); }
    .search-results-overlay { position: absolute; top: calc(100% + 8px); left: 0; right: 0; background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow-xl); max-height: 420px; overflow-y: auto; display: none; z-index: 100; border: 1px solid var(--gray-200); }
    .search-results-overlay.active { display: block; }
    .search-result-item { display: flex; align-items: center; gap: 14px; padding: 10px 16px; border-bottom: 1px solid var(--gray-100); transition: var(--transition); cursor: pointer; }
    .search-result-item:hover { background: var(--gray-50); }
    .search-result-item:last-child { border-bottom: none; }
    .search-result-item img { width: 44px; height: 44px; object-fit: cover; border-radius: var(--radius-sm); background: var(--gray-100); flex-shrink: 0; }
    .search-result-item .result-info { flex: 1; min-width: 0; }
    .search-result-item .result-info .result-name { font-weight: 600; font-size: 0.9rem; color: var(--gray-900); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .search-result-item .result-info .result-meta { font-size: 0.8rem; color: var(--gray-500); }
    .search-result-item .result-price { font-weight: 700; font-size: 0.95rem; color: var(--navy); flex-shrink: 0; }
    .search-no-results { padding: 24px 16px; text-align: center; color: var(--gray-500); }
    @media (max-width: 1024px) { .products-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; } }
    @media (max-width: 768px) { .header-inner { flex-wrap: nowrap; gap: 10px; } .header-brand span { font-size: 1.1rem; } .header-brand img { height: 32px; } .header-search { display: none; } .header-search.mobile-show { display: block; width: 100%; order: 10; margin-top: 6px; } .hamburger { display: flex; } .header-actions .btn { padding: 6px 12px; font-size: 0.7rem; min-height: 34px; } .header-actions .btn span { display: none; } .hero-section { padding: 32px 0 28px; } .hero-section h1 { font-size: 1.5rem; } .hero-section p { font-size: 0.95rem; margin-bottom: 16px; } .hero-search input { height: 48px; font-size: 0.95rem; padding: 12px 50px 12px 18px; } .hero-search button { padding: 8px 16px; font-size: 0.8rem; } .products-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } .product-card .card-body { padding: 10px 12px 12px; } .product-card .card-body .product-name { font-size: 0.85rem; } .product-card .card-body .current-price { font-size: 1rem; } .product-card .card-footer { padding: 8px 12px 12px; flex-direction: column; gap: 6px; } .product-card .card-footer .btn { font-size: 0.7rem; padding: 6px 8px; min-height: 32px; } .section-title { font-size: 1.3rem; } .footer-grid { grid-template-columns: 1fr 1fr; gap: 24px; } .category-nav a { font-size: 0.75rem; padding: 4px 12px; } .search-results-overlay { max-height: 300px; } }
    @media (max-width: 480px) { .container { padding: 0 12px; } .products-grid { gap: 10px; } .product-card .card-body .product-name { font-size: 0.8rem; } .product-card .card-body .current-price { font-size: 0.9rem; } .product-card .discount-badge { font-size: 0.6rem; padding: 2px 8px; } .hero-section h1 { font-size: 1.3rem; } }
    @keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
    .product-card { animation: fadeUp 0.4s ease forwards; }
    .toast { position: fixed; bottom: 24px; right: 24px; background: var(--navy); color: var(--white); padding: 14px 24px; border-radius: var(--radius); box-shadow: var(--shadow-lg); font-weight: 500; z-index: 9999; transform: translateY(120px); opacity: 0; transition: var(--transition); max-width: 400px; border-left: 4px solid var(--gold); }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { border-left-color: #28a745; }
    .toast.error { border-left-color: #dc3545; }
    .breadcrumb { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--gray-600); padding: 12px 0; flex-wrap: wrap; }
    .breadcrumb a { color: var(--navy); font-weight: 500; }
    .breadcrumb a:hover { color: var(--gold); }
    .breadcrumb .separator { color: var(--gray-400); }
    .pagination { display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 32px; flex-wrap: wrap; }
    .pagination a, .pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 8px; border-radius: var(--radius-sm); font-size: 0.9rem; font-weight: 500; color: var(--gray-700); transition: var(--transition); border: 1px solid transparent; }
    .pagination a:hover { background: var(--gray-100); border-color: var(--gray-300); }
    .pagination a.active { background: var(--navy); color: var(--white); border-color: var(--navy); }
    .pagination a.disabled { opacity: 0.4; pointer-events: none; }
  </style>
</head>
<body>
  <!-- HEADER -->
  <header class="site-header" id="siteHeader">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="header-brand">
          <img src="/images/shool-bazar-logo.jpeg" alt="Shool Bazar" />
          <span>Shool <span class="gold">Bazar</span></span>
        </a>
        <div class="header-search" id="desktopSearch">
          <input type="text" id="searchInputDesktop" placeholder="Search products, brands, categories..." autocomplete="off" />
          <span class="search-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </span>
          <div class="search-results-overlay" id="searchResultsDesktop"></div>
        </div>
        <div class="header-actions">
          <a href="/" class="btn btn-outline-gold btn-sm" title="Home">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-9 9 9"/><path d="M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10"/></svg>
            <span>Home</span>
          </a>
          <button class="hamburger" id="hamburgerBtn" aria-label="Toggle navigation">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <div class="header-search mobile-show" id="mobileSearch" style="display:none; margin-top: 8px;">
        <input type="text" id="searchInputMobile" placeholder="Search products..." autocomplete="off" />
        <span class="search-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <div class="search-results-overlay" id="searchResultsMobile"></div>
      </div>
      <div class="mobile-nav" id="mobileNav">
        <a href="/">Home</a>
        <a href="/categories">Categories</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
    </div>
  </header>

  <!-- CATEGORY NAV -->
  <nav class="category-nav" id="categoryNav">
    <div class="container" id="categoryList">
      <% if (categories && categories.length) { %>
        <a href="/" class="<%= !currentCategory ? 'active' : '' %>">?? All</a>
        <% categories.forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="<%= currentCategory && currentCategory.id === cat.id ? 'active' : '' %>" data-cat-id="<%= cat.id %>">
            <%= cat.icon || '??' %> <%= cat.name %>
          </a>
        <% }); %>
      <% } else { %>
        <span style="color:var(--gray-500);font-size:0.85rem;padding:4px 8px;">No categories</span>
      <% } %>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero-section">
    <div class="container">
      <h1>Discover Amazing <span class="gold">Products</span></h1>
      <p>Find the best deals from trusted merchants across the web, all in one place.</p>
      <div class="hero-search">
        <input type="text" id="heroSearchInput" placeholder="What are you looking for?" autocomplete="off" />
        <button id="heroSearchBtn">Search</button>
        <div class="search-results-overlay" id="heroSearchResults"></div>
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="featured-section" id="featuredSection">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">? Featured <span class="gold">Picks</span></h2>
          <p class="section-subtitle">Handpicked products you'll love</p>
        </div>
      </div>
      <div class="products-grid" id="featuredGrid">
        <% if (featured && featured.length) { %>
          <% featured.forEach(p => { %>
            <div class="product-card" data-product-id="<%= p.id %>" data-slug="<%= p.slug %>">
              <a href="/product/<%= p.slug %>" class="card-image" style="display:block;">
                <img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/images/placeholder.png'" />
                <% if (p.discount && p.discount > 0) { %>
                  <span class="discount-badge"><%= Math.round(p.discount) %>% OFF</span>
                <% } %>
              </a>
              <div class="card-body">
                <a href="/product/<%= p.slug %>" class="product-name"><%= p.name %></a>
                <% if (p.brand) { %><div class="product-brand"><%= p.brand %></div><% } %>
                <div class="product-price">
                  <% if (p.price) { %>
                    <span class="current-price">?<%= Number(p.price).toLocaleString('en-IN') %></span>
                    <% if (p.mrp && p.mrp != p.price) { %>
                      <span class="original-price">?<%= Number(p.mrp).toLocaleString('en-IN') %></span>
                    <% } %>
                    <% if (p.discount && p.discount > 0) { %>
                      <span class="discount-text"><%= Math.round(p.discount) %>%</span>
                    <% } %>
                  <% } else { %>
                    <span style="color:var(--gray-500);font-size:0.85rem;">Price on request</span>
                  <% } %>
                </div>
              </div>
              <div class="card-footer">
                <a href="/product/<%= p.slug %>" class="btn btn-outline-navy btn-sm">View</a>
                <a href="/go/<%= p.slug %>" class="btn btn-gold btn-sm" data-track-click="<%= p.id %>">Buy Now</a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state" style="grid-column:1/-1;">
            <div class="empty-icon">?</div>
            <h3>No featured products</h3>
            <p>Check back soon for handpicked items.</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ALL PRODUCTS -->
  <section class="products-section" id="allProductsSection">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">All <span class="gold">Products</span></h2>
          <p class="section-subtitle" id="productCountLabel"><%= totalProducts %> products available</p>
        </div>
      </div>
      <div class="products-grid" id="allProductsGrid">
        <% if (products && products.length) { %>
          <% products.forEach(p => { %>
            <div class="product-card" data-product-id="<%= p.id %>" data-slug="<%= p.slug %>">
              <a href="/product/<%= p.slug %>" class="card-image" style="display:block;">
                <img src="<%= p.image || '/images/placeholder.png' %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/images/placeholder.png'" />
                <% if (p.discount && p.discount > 0) { %>
                  <span class="discount-badge"><%= Math.round(p.discount) %>% OFF</span>
                <% } %>
              </a>
              <div class="card-body">
                <a href="/product/<%= p.slug %>" class="product-name"><%= p.name %></a>
                <% if (p.brand) { %><div class="product-brand"><%= p.brand %></div><% } %>
                <div class="product-price">
                  <% if (p.price) { %>
                    <span class="current-price">?<%= Number(p.price).toLocaleString('en-IN') %></span>
                    <% if (p.mrp && p.mrp != p.price) { %>
                      <span class="original-price">?<%= Number(p.mrp).toLocaleString('en-IN') %></span>
                    <% } %>
                    <% if (p.discount && p.discount > 0) { %>
                      <span class="discount-text"><%= Math.round(p.discount) %>%</span>
                    <% } %>
                  <% } else { %>
                    <span style="color:var(--gray-500);font-size:0.85rem;">Price on request</span>
                  <% } %>
                </div>
              </div>
              <div class="card-footer">
                <a href="/product/<%= p.slug %>" class="btn btn-outline-navy btn-sm">View</a>
                <a href="/go/<%= p.slug %>" class="btn btn-gold btn-sm" data-track-click="<%= p.id %>">Buy Now</a>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-state" style="grid-column:1/-1;">
            <div class="empty-icon">??</div>
            <h3>No products found</h3>
            <p>Check back later for new arrivals.</p>
          </div>
        <% } %>
      </div>
      <!-- Pagination -->
      <div class="pagination" id="paginationControls">
        <% if (totalPages > 1) { %>
          <% const current = currentPage || 1; %>
          <% const prev = current > 1 ? current - 1 : 1; %>
          <a href="/?page=<%= prev %>" class="<%= current <= 1 ? 'disabled' : '' %>">‹</a>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= current-2 && i <= current+2)) { %>
              <a href="/?page=<%= i %>" class="<%= i === current ? 'active' : '' %>"><%= i %></a>
            <% } else if (i === current-3 || i === current+3) { %>
              <span>…</span>
            <% } %>
          <% } %>
          <a href="/?page=<%= current+1 %>" class="<%= current >= totalPages ? 'disabled' : '' %>">›</a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- FOOTER -->

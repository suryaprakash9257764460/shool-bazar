  <!-- META PIXEL -->
  <script>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','1365924354934790');fbq('track','PageView');
    window.fbqEvent = function(event,data){ if(typeof fbq!=='undefined') fbq('track',event,data||{}); };
    window.trackProductView = function(product){ if(product&&product.id) fbqEvent('ViewContent',{content_ids:[String(product.id)],content_type:'product',value:product.price||0,currency:'INR',content_name:product.name||'Product'}); };
    window.trackSearch = function(query){ if(query&&query.length>0) fbqEvent('Search',{search_string:query}); };
    window.trackOutboundClick = function(product){ if(product&&product.id) fbqEvent('AddToCart',{content_ids:[String(product.id)],content_type:'product',value:product.price||0,currency:'INR'}); };
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1365924354934790&ev=PageView&noscript=1"/></noscript>

  <!-- CLIENT SCRIPT -->
  <script>
    (function() {
      // Search functionality
      const searchInputs = [
        document.getElementById('searchInputDesktop'),
        document.getElementById('searchInputMobile'),
        document.getElementById('heroSearchInput')
      ];
      const searchContainers = [
        document.getElementById('searchResultsDesktop'),
        document.getElementById('searchResultsMobile'),
        document.getElementById('heroSearchResults')
      ];

      let timeout = null;
      function performSearch(query, container) {
        if (!query || query.length < 1) { container.classList.remove('active'); return; }
        clearTimeout(timeout);
        timeout = setTimeout(async () => {
          try {
            const res = await fetch('/api/search?q='+encodeURIComponent(query));
            const data = await res.json();
            const results = data.products || [];
            if (results.length === 0) {
              container.innerHTML = `<div class="search-no-results"><div style="font-size:1.5rem;">??</div><strong>No results found</strong><p style="font-size:0.85rem;color:var(--gray-500);">Try adjusting your search</p></div>`;
              container.classList.add('active');
              return;
            }
            let html = '';
            results.slice(0,8).forEach(p => {
              const img = p.image || '/images/placeholder.png';
              const price = p.price ? '?'+Number(p.price).toLocaleString('en-IN') : '';
              html += `<a href="/product/${p.slug}" class="search-result-item"><img src="${img}" alt="${p.name}" loading="lazy" onerror="this.src='/images/placeholder.png'" /><div class="result-info"><div class="result-name">${p.name}</div><div class="result-meta">${p.brand||''} ${p.category_name?'· '+p.category_name:''}</div></div>${price ? `<div class="result-price">${price}</div>` : ''}</a>`;
            });
            if (results.length > 8) html += `<div style="padding:8px 16px;text-align:center;font-size:0.85rem;color:var(--gray-500);border-top:1px solid var(--gray-100);"><a href="/search?q=${encodeURIComponent(query)}" style="color:var(--gold);font-weight:600;">View all ${results.length} results ?</a></div>`;
            container.innerHTML = html;
            container.classList.add('active');
            window.trackSearch(query);
          } catch(e) {
            container.innerHTML = `<div class="search-no-results" style="color:var(--gray-500);"><div style="font-size:1.5rem;">??</div><strong>Search unavailable</strong><p style="font-size:0.85rem;">Please try again later.</p></div>`;
            container.classList.add('active');
          }
        }, 300);
      }

      searchInputs.forEach((input, idx) => {
        if (!input) return;
        const container = searchContainers[idx];
        input.addEventListener('input', () => performSearch(input.value.trim(), container));
        input.addEventListener('focus', () => { const q = input.value.trim(); if (q) performSearch(q, container); });
        input.addEventListener('blur', () => setTimeout(() => container.classList.remove('active'), 200));
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { container.classList.remove('active'); input.blur(); }
          if (e.key === 'Enter') { const q = input.value.trim(); if (q) window.location.href = '/search?q='+encodeURIComponent(q); }
        });
      });

      // Hamburger
      const hamburger = document.getElementById('hamburgerBtn');
      const mobileNav = document.getElementById('mobileNav');
      const mobileSearch = document.getElementById('mobileSearch');
      if (hamburger) {
        hamburger.addEventListener('click', () => {
          mobileNav.classList.toggle('open');
          const isOpen = mobileNav.classList.contains('open');
          hamburger.setAttribute('aria-expanded', isOpen);
          if (isOpen) { mobileSearch.style.display = 'block'; setTimeout(() => document.getElementById('searchInputMobile')?.focus(), 100); }
          else mobileSearch.style.display = 'none';
        });
      }
      document.querySelectorAll('.mobile-nav a').forEach(link => {
        link.addEventListener('click', () => {
          mobileNav.classList.remove('open');
          hamburger.setAttribute('aria-expanded', 'false');
          mobileSearch.style.display = 'none';
        });
      });

      // Hero search button
      const heroBtn = document.getElementById('heroSearchBtn');
      if (heroBtn) {
        heroBtn.addEventListener('click', () => {
          const q = document.getElementById('heroSearchInput')?.value?.trim();
          if (q) window.location.href = '/search?q='+encodeURIComponent(q);
        });
      }

      // Track outbound clicks
      document.addEventListener('click', (e) => {
        const link = e.target.closest('[data-track-click]');
        if (link) {
          const pid = link.getAttribute('data-track-click');
          if (pid) {
            // try to find product in page data
            const card = link.closest('.product-card');
            let product = null;
            if (card) {
              const name = card.querySelector('.product-name')?.textContent || '';
              const price = parseFloat(card.querySelector('.current-price')?.textContent?.replace(/[^0-9.]/g,'')) || 0;
              product = { id: pid, name, price };
            }
            if (product) window.trackOutboundClick(product);
          }
        }
      });
    })();
  </script>
</body>
